---
// Every file of the newest release, by system, in a fixed order. The
// visitor's system is marked and its main file solid; nothing moves.
import DownloadButton from "../components/DownloadButton.astro"
import Page from "../layouts/Page.astro"
import { fileUrl, files, site, type Os } from "../site"

const systems: { os: Os; label: string }[] = [
    { os: "mac", label: "Mac" },
    { os: "windows", label: "Windows" },
    { os: "linux", label: "Linux" },
]
// Complete class names, so Tailwind finds them. A Mac's is the default.
const yours = {
    mac: "windows:hidden linux:hidden",
    windows: "hidden windows:inline",
    linux: "hidden linux:inline",
}
---

<Page
    title="Download Rollport"
    description="Rollport for Mac, Windows, and Linux: every download of the newest version."
>
    <main class="wrap pt-12 pb-16">
        <h1 class="text-3xl font-semibold">Download Rollport</h1>
        <p class="mt-3 flex flex-wrap gap-x-4 text-muted">
            <span>Version {site.version}</span>
            <a class="link" href={site.releases}>
                All releases
            </a>
        </p>

        <div class="mt-12 grid gap-12 sm:grid-cols-3 sm:gap-6">
            {systems.map(({ os, label }) => (
                <section class="flex flex-col gap-2">
                    <h2 class="mb-1 flex flex-wrap items-baseline gap-x-2 text-xl font-semibold">
                        {label}
                        <span
                            class:list={[
                                "text-sm font-normal text-muted",
                                yours[os],
                            ]}
                        >
                            Your system
                        </span>
                    </h2>
                    {files
                        .filter((file) => file.os === os)
                        .map((file) => (
                            <DownloadButton
                                file={file}
                                href={fileUrl(file.name)}
                            />
                        ))}
                </section>
            ))}
        </div>
    </main>
</Page>
