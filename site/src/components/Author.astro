            vector-effect="non-scaling-stroke"
            d="M40.05 38.836c-.58-.884-1.462-1.695-2.854-1.549-3.273.344-5.106 2.65-5.504 3.004-4.563 4.056-5.996 7.438-6.97 8.25-3.593 2.994-5.812-1.222-7.111-4.339-2.455-5.894-4.569-3.505-6.756-1.991-5.877 4.069-3.246-7.204-3.133-7.751 2.644-12.718 5.513-26.025 19.964-31.228 5.409-1.947 23.284-3.53 33.826 4.554 2.295 1.759 23.518 18.032 18.584 31.506-.214.587-2.112 15.187-5.38 16.004-3.792.948-5.863-6.486-5.984-7.206-1.005-5.949-6.138-13.524-12.215-12.64-5.335.778-5.964 6.439-11.527 8.823-1.931.828-2.449-1.066-2.489-1.138-1.34-2.413-1.598-3.643-3.647-5.506"
