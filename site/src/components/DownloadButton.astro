---
// One release file as a button: its format, and under it who it is for. The
// visitor's main file is solid, every other one soft (windows: and linux:
// variants; a Mac's is the default). It opens Get started, which starts the
// download and shows the steps for that file.
import Download from "@lucide/astro/icons/download"
import { downloadPage, mainFile, type ReleaseFile } from "../site"

interface Props {
    file: ReleaseFile
    /** The download page's main button: taller, larger type. */
    big?: boolean
    /** Content in the middle: the download page's block for your system. */
    center?: boolean
    /** Solid on every system: the one file a format tab shows. */
    solid?: boolean
}
const { file, big, center, solid } = Astro.props
const main = mainFile(file.os) === file

// Complete class names, so Tailwind finds them.
const soft = "border-line bg-subtle transition-colors hover:bg-element"
const solidOn = {
    mac: "border-ink bg-ink text-canvas windows:border-line windows:bg-subtle windows:text-ink windows:hover:bg-element linux:border-line linux:bg-subtle linux:text-ink linux:hover:bg-element",
    windows:
        "border-line bg-subtle hover:bg-element windows:border-ink windows:bg-ink windows:text-canvas",
    linux: "border-line bg-subtle hover:bg-element linux:border-ink linux:bg-ink linux:text-canvas",
}
---

<a
    class:list={[
        "flex items-center rounded-xl border",
        center && "justify-center",
        big
            ? "min-h-[4.25rem] gap-[0.875rem] rounded-[0.875rem] px-[1.75rem] py-[0.625rem]"
            : "min-h-[3.625rem] gap-3 px-4 py-2",
        solid
            ? "raised border-ink bg-ink text-canvas"
            : main
              ? solidOn[file.os]
              : soft,
    ]}
    href={downloadPage(file.name)}
    data-main={main && !solid ? file.os : undefined}
>
    <!-- As tall as the two lines beside it, like a drop cap. -->
    <Download
        class="shrink-0"
        size={big ? 32 : 24}
        stroke-width={big ? 1.5 : 1.75}
        aria-hidden="true"
    />
    <span class:list={["grid", big ? "leading-tight" : "leading-snug"]}>
        <span class:list={["font-semibold", big && "text-lg"]}>
            {file.format}
        </span>
        {"detail" in file && (
            <span class="text-sm opacity-70">{file.detail}</span>
        )}
    </span>
</a>

<style>
    @reference "../styles/global.css";

    /* The visitor's main file is raised; which one is the page's data-os. */
    :global(html:not([data-os="windows"], [data-os="linux"])) [data-main="mac"],
    :global(html[data-os="windows"]) [data-main="windows"],
    :global(html[data-os="linux"]) [data-main="linux"] {
        @apply raised;
    }
</style>
