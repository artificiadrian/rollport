---
// One release file as a Button: its format, and under it who it is for. The
// visitor's main file is solid, every other one soft. It opens Get started,
// which starts the download and shows the steps for that file.
import Download from "@lucide/astro/icons/download"
import { downloadPage, mainFile, type ReleaseFile } from "../site"
import Button from "./Button.astro"

interface Props {
    file: ReleaseFile
    /** The download page's main button. */
    large?: boolean
    /** Content in the middle: the download page's block for your system. */
    center?: boolean
    /** Solid on every system: the one file a format tab shows. */
    solid?: boolean
}
const { file, large, center, solid } = Astro.props
const main = mainFile(file.os) === file
---

<Button
    href={downloadPage(file.name)}
    variant={solid ? "solid" : "soft"}
    solidOn={!solid && main ? file.os : undefined}
    size={large ? "large" : "file"}
    center={center}
>
    <!-- As tall as the two lines beside it, like a drop cap. -->
    <Download
        slot="icon"
        class="shrink-0"
        size={large ? 32 : 24}
        stroke-width={large ? 1.5 : 1.75}
        aria-hidden="true"
    />
    {file.format}
    {"detail" in file && <Fragment slot="detail">{file.detail}</Fragment>}
</Button>
