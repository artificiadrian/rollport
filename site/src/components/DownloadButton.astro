---
// One release file as a Button: its format, and under it who it is for. The
// visitor's main file is solid, every other one soft. It opens Get started,
// which starts the download and shows the steps for that file; on Get started
// itself it downloads the file at once.
import Download from "@lucide/astro/icons/download"
import { downloadPage, fileUrl, mainFile, type ReleaseFile } from "../site"
import Button from "./Button.astro"

interface Props {
    file: ReleaseFile
    /** Solid on every system: the one file a format tab shows. */
    solid?: boolean
    /** Download the file itself: the page already shows its steps. */
    direct?: boolean
}
const { file, solid, direct } = Astro.props
const main = mainFile(file.os) === file
---

<Button
    href={direct ? fileUrl(file.name) : downloadPage(file.name)}
    variant={solid ? "solid" : "soft"}
    solidOn={!solid && main ? file.os : undefined}
    size="file"
>
    <!-- As tall as the two lines beside it. -->
    <Download
        slot="icon"
        class="shrink-0"
        size={24}
        stroke-width={1.75}
        aria-hidden="true"
    />
    {file.format}
    {"detail" in file && <Fragment slot="detail">{file.detail}</Fragment>}
</Button>
