---
// One release file as a button: its format, and under it who it is for. The
// visitor's main file is solid, every other one soft (windows: and linux:
// variants; a Mac's is the default). It opens Get started, which starts the
// download and shows the steps for that file.
import Download from "@lucide/astro/icons/download"
import { downloadPage, mainFile, type ReleaseFile } from "../site"

interface Props {
    file: ReleaseFile
    /** The download page's main button: taller, larger type. */
    big?: boolean
}
const { file, big } = Astro.props
const main = mainFile(file.os) === file

// Complete class names, so Tailwind finds them.
const soft = "border-line bg-subtle hover:bg-element"
const solidOn = {
    mac: "border-ink bg-ink text-canvas hover:bg-ink/85 windows:border-line windows:bg-subtle windows:text-ink windows:hover:bg-element linux:border-line linux:bg-subtle linux:text-ink linux:hover:bg-element",
    windows:
        "border-line bg-subtle hover:bg-element windows:border-ink windows:bg-ink windows:text-canvas windows:hover:bg-ink/85",
    linux: "border-line bg-subtle hover:bg-element linux:border-ink linux:bg-ink linux:text-canvas linux:hover:bg-ink/85",
}
---

<a
    class:list={[
        "flex items-center gap-3 rounded-xl border px-4 py-2 transition-colors",
        big ? "min-h-[4.5rem] text-lg" : "min-h-[3.625rem]",
        main ? solidOn[file.os] : soft,
    ]}
    href={downloadPage(file.name)}
>
    <!-- As tall as the two lines beside it. -->
    <Download
        class="shrink-0"
        size={24}
        stroke-width={1.75}
        aria-hidden="true"
    />
    <span class="grid leading-snug">
        <span class="font-semibold">{file.format}</span>
        {"detail" in file && (
            <span class="text-sm opacity-70">{file.detail}</span>
        )}
    </span>
</a>
