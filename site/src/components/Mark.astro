---
// Three stacked photo prints, the picture the app shows before an import.
interface Props {
    size?: number
}
const { size = 24 } = Astro.props
---

<svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
    aria-hidden="true"
>
    <rect
        x="2.5"
        y="6"
        width="12"
        height="10"
        rx="1.6"
        transform="rotate(-9 8.5 11)"
        opacity="0.45"
    />
    <rect
        x="9.5"
        y="5"
        width="12"
        height="10"
        rx="1.6"
        transform="rotate(8 15.5 10)"
        opacity="0.45"
    />
    <rect x="6" y="8" width="12" height="10" rx="1.6" fill="var(--canvas)" />
    <path d="m7.5 16 3-3 2 2 1.5-1.5 2.5 2.5" />
</svg>
