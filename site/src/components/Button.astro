---
// A link that looks like a button: solid for the main action, soft (a light
// fill with a faint edge) for the others beside it. 44 px tall, easy to hit.
interface Props {
    href: string
    variant: "solid" | "soft"
    class?: string
}
const { href, variant, class: className } = Astro.props
---

<a
    class:list={[
        "inline-flex h-[2.75rem] items-center gap-2 rounded-xl px-4 font-medium transition-colors",
        variant === "solid"
            ? "bg-ink text-canvas hover:bg-ink/85"
            : "border border-line bg-subtle hover:bg-element",
        className,
    ]}
    href={href}
>
    <slot />
</a>
