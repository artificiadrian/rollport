---
// The keys of one shortcut: a Mac's side by side, as Apple writes them;
// Windows and Linux joined by a muted +, as Microsoft writes them.
import Kbd from "./Kbd.astro"

interface Props {
    keys: string[]
    /** Windows and Linux: join the keys with a +. */
    joined?: boolean
}
const { keys, joined } = Astro.props
---

<span class="whitespace-nowrap">
    {keys.map((key, i) => (
        <>
            {i > 0 &&
                (joined ? <span class="mx-[0.15em] text-muted">+</span> : " ")}
            <Kbd>{key}</Kbd>
        </>
    ))}
</span>
